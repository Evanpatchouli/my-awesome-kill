{
  "name": "my-awesome-kill",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "pnpm --filter @mak/game dev",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm --filter @mak/game build",
    "tauri": "pnpm --filter @mak/game tauri",
    "engine:build": "node scripts/build-engine.mjs",
    "engine:test": "cargo test --locked --manifest-path packages/duel-core/Cargo.toml && node scripts/build-engine.mjs && node scripts/test-engine-web.mjs"
  }
}
